# Bedrock LLM settings (mirrors finops-ai-assistant)
LLM_PROVIDER=bedrock
LLM_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_REGION=us-east-1
# BEDROCK_INFERENCE_PROFILE_ARN=
# Locally use AWS_PROFILE=thorium-team-sandbox; in ECS/Lambda use IAM task role
AWS_PROFILE=thorium-team-sandbox

# Execution mode (true = no live Jira/GitHub/Teams mutations)
DRY_RUN=true

# Repo paths & config
REPOS_CONFIG_PATH=config/repos.yaml
WORKSPACES_ROOT=/Users/psingh/Desktop/Workyard
STATE_FILE_PATH=.afa_state.json

# Jira (service account)
JIRA_BASE_URL=https://flexera.atlassian.net
JIRA_USER_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_WEBHOOK_SECRET=replace-with-a-random-secret

# GitHub (service account / GitHub App token)
GITHUB_TOKEN=your_github_token
GITHUB_BASE_BRANCH=develop

# Notifications (AWS SES)
SES_REGION=us-east-1
SES_SENDER_EMAIL=
NOTIFY_EMAIL_TO=
# TEAMS_WEBHOOK_URL=
